#!/bin/sh
# Replace the installed herdsman executable after a commit lands — but only
# when the checks pass.  post-commit / post-merge / post-rewrite call this
# detached, so a commit never waits on a ~30s gate.
#
# Three files, all in the common git dir so every worktree shares them:
#   build-hook.log    every run in order; a failure names the step that broke
#   build-hook.state  the commit last installed (decides whether UI checks run)
#   build-hook.lock   one run at a time, across all worktrees
#
# Manual run:  sh "$(git rev-parse --git-path hooks)/herdsman-build"
#              then  tail -f "$(git rev-parse --git-common-dir)/build-hook.log"
set -u

event=${1:-manual}
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
common=$(git rev-parse --git-common-dir) || exit 0
log=$common/build-hook.log

exec >>"$log" 2>&1 || exit 0

# One run at a time: a burst of commits (an interactive rebase fires this hook
# per commit) collapses into one build of whatever HEAD is when it starts.
exec 9>"$common/build-hook.lock" || exit 0
flock -n 9 || { echo "$(date -Is) $event: skipped, a build is already in flight"; exit 0; }

sha=$(git rev-parse HEAD)
short=$(git rev-parse --short=12 HEAD)
echo ""
echo "$(date -Is) $event: build $(git symbolic-ref --short -q HEAD || echo detached) @$short"

fail() {
    echo "FAILED at: $*"
    echo "the installed executable keeps the last build that passed"
    [ "$(git rev-parse HEAD 2>/dev/null)" = "$sha" ] || rebuild_tip
    exit 1
}

# A commit landing while we run leaves us holding a stale tree — later events
# were skipped by the lock, so re-run against the tip instead of shipping it.
rebuild_tip() {
    echo "HEAD is now $(git rev-parse --short=12 HEAD); rebuilding that instead"
    exec 9>&-
    exec sh "$0" "$event"
}

echo "--- uv run pytest -q"
uv run pytest -q || fail pytest
echo "--- uv run basedpyright"
uv run basedpyright || fail basedpyright

# The wheel ships ui/build, so the UI gate only matters when ui/ moved since
# the installed commit, or the bundle has never been built in this tree.
state=$common/build-hook.state
need_ui=1
if [ -r "$state" ] && [ -d ui/build ] && git cat-file -e "$(cat "$state")^{commit}" 2>/dev/null; then
    need_ui=0
    git diff --quiet "$(cat "$state")" HEAD -- ui || need_ui=1
fi
if [ "$need_ui" = 1 ]; then
    echo "--- ui: npm run check && npm run build && field-check && a11y-check"
    (cd ui && npm run check && npm run build && node dev/field-check.ts && node dev/a11y-check.ts) \
        || fail "ui checks"
fi

echo "--- uv build --wheel --out-dir dist"
uv build --wheel --out-dir dist || fail "uv build"
wheel=$(ls -t dist/*.whl | head -n 1)
echo "--- uv tool install --force $wheel"
uv tool install --force "$wheel" || fail "uv tool install"
"${UV_TOOL_BIN_DIR:-$HOME/.local/bin}/herdsman" --help >/dev/null \
    || fail "installed herdsman --help"

echo "$sha" >"$state"
echo "OK: $(basename "$wheel") from @$short is installed"
[ "$(git rev-parse HEAD)" = "$sha" ] || rebuild_tip
